#!/usr/bin/env python

import sys, os
import subprocess
try:
    theme = sys.argv[1]
    home = os.path.expanduser("~")
    
    with open(home + "/.config/yazi/theme.toml", "w") as f:
      if theme in ("tokyonight", "cybermesh", "protocol", "bamboo"):
        f.write("")
        subprocess.run("\cp -r ~/.config/rmpc-rounded/. ~/.config/rmpc", shell=True)
        subprocess.run("\cp -r ~/.config/waybar/bars/bar1/. ~/.config/waybar/", shell=True)
      else:
        f.write("[indicator]\n\"padding\" = { open = \"█\", close = \"█\" }")
        subprocess.run("\cp -r ~/.config/rmpc-plain/. ~/.config/rmpc", shell=True)
        subprocess.run("\cp -r ~/.config/waybar/bars/bar2/. ~/.config/waybar/", shell=True)
except:
    sys.exit("Usage: yazi-pad <theme-name>")

