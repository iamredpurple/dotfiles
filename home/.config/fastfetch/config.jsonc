{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    //"type": "file", //"kitty-direct",
    "source": "auto", //"~/.config/fastfetch/images/archlinux.png",
    "color" : {
      "1" : "blue",
      "2" : "blue",
    },
    "width": 35,
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "title" : "blue",
      "keys" : "blue",
    },
  },
  "modules": [

    // Title
    {
      "type": "title",
      "format": "{#1}╭───────────── {#}{user-name-colored} @ {#}{host-name-colored}"
    },

    // System Information
    {
      "type": "custom",
      "format": "{#1}│ {#}\u001b[91mSystem Information"
    },
    {
      "type": "os",
      "key": "{#separator}│  {#keys}\uf303 OS" //
    },
    {
      "type": "kernel",
      "key": "{#separator}│  {#keys}󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "{#separator}│  {#keys}󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "{#separator}│  {#keys}󰏖 Packages",
      "format": "{all}"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },

    // Desktop Environment
    {
      "type": "custom",
      "format": "{#1}│ {#}\u001b[91mDesktop Environment"
    },
    {
      "type": "de",
      "key": "{#separator}│  {#keys}󰧨 DE"
    },
    {
      "type": "wm",
      "key": "{#separator}│  {#keys} WM"
    },
    {
      "type": "wmtheme",
      "key": "{#separator}│  {#keys}󰉼 Theme"
    },
    {
      "type": "display",
      "key": "{#separator}│  {#keys}󰹑 Display"
    },
    {
      "type": "shell",
      "key": "{#separator}│  {#keys}󰞷 Shell"
    },
    {
      "type": "terminalfont",
      "key": "{#separator}│  {#keys}󰛖 Font"
    },
    {
      "type": "custom",
      "format": "{#1}│"
    },

    // Hardware Information
    {
      "type": "custom",
      "format": "{#1}│ {#}\u001b[91mHardware Information"
    },

    {
      "type": "host",
      "key": "{#separator}│  {#keys}󰍹 PC"
    },
    {
      "type": "custom", // use cpu instead of custom to get actual cpu info
      //"key": "{#separator}│  {#keys}󰻠 CPU" //uncomment key to display actual cpu info
      "format": "{#separator}│  {#1}{#keys}󰻠 CPU  {#}Intel Core i7-9750H (12) @ 4.50 GHz" //comment this when using "cpu" instead of "custom"
    },
    {
      "type": "custom", // use gpu instead of custom to get actual gpu info
      //"key": "{#separator}│  {#keys}󰢮 GPU"
      "format": "{#separator}│  {#1}{#keys}󰢮 GPU  {#}NVIDIA GeForce GTX 1660Ti [Discrete]"
    },
    {
      "type": "custom", // use gpu instead of custom to get actual gpu info
      //"key": "{#separator}│  {#keys}󰢮 GPU"
      "format": "{#separator}│  {#1}{#keys}󰢮 GPU  {#}Intel UHD 630 @ 1.15 GHz [Integrated]"
    },
    {
      "type": "memory",
      "key": "{#separator}│  {#keys}󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "{#separator}│  {#keys}󰋊 Disk (/)",
      "folders": "/"
    },
    // {
    //   "type": "disk",
    //   "key": "{#separator}│  {#keys}󰋊 Disk",
    //   "showRemovable": true
    // },
    {
      "type": "custom",
      "format": "{#1}│"
    },

    // Colors
    {
      "type": "colors",
      "key": "{#separator}│",
      "symbol": "circle"
    },

    // Footer
    {
      "type": "custom",
      "format": "{#1}╰───────────────────────────────╯"
    }
  ]
}
