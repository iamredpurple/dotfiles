{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "#5e81ac",
    "secondary": "{{ bright_blue }}",
    "accent": "{{ bright_foreground }}",
    "error": "{{ red }}",
    "warning": "{{ orange }}",
    "success": "{{ green }}",
    "info": "{{ cyan }}",
    "text": "#1c2d28",
    "textMuted": "{{ muted }}",
    "selectedListItemText": "#dfe4c4",
    "background": "#dfe4c4",
    "backgroundPanel": "{{ dark_background }}",
    "backgroundElement": "{{ darker_background }}",
    "border": "{{ lighter_background }}",
    "borderActive": "#5e81ac",
    "borderSubtle": "{{ darker_background }}",
    "diffAdded": "{{ green }}",
    "diffRemoved": "{{ red }}",
    "diffContext": "{{ muted }}",
    "diffHunkHeader": "{{ bright_blue }}",
    "diffHighlightAdded": "{{ bright_green }}",
    "diffHighlightRemoved": "{{ bright_red }}",
    "diffAddedBg": "{{ selection }}",
    "diffRemovedBg": "{{ selection }}",
    "diffContextBg": "{{ darker_background }}",
    "diffLineNumber": "{{ muted }}",
    "diffAddedLineNumberBg": "{{ selection }}",
    "diffRemovedLineNumberBg": "{{ selection }}",
    "markdownText": "#1c2d28",
    "markdownHeading": "{{ bright_foreground }}",
    "markdownLink": "#5e81ac",
    "markdownLinkText": "{{ cyan }}",
    "markdownCode": "{{ green }}",
    "markdownBlockQuote": "{{ muted }}",
    "markdownEmph": "{{ dark_foreground }}",
    "markdownStrong": "{{ bright_foreground }}",
    "markdownHorizontalRule": "{{ muted }}",
    "markdownListItem": "#5e81ac",
    "markdownListEnumeration": "{{ cyan }}",
    "markdownImage": "{{ yellow }}",
    "markdownImageText": "{{ cyan }}",
    "markdownCodeBlock": "{{ dark_foreground }}",
    "syntaxComment": "{{ muted }}",
    "syntaxKeyword": "{{ magenta }}",
    "syntaxFunction": "{{ bright_cyan }}",
    "syntaxVariable": "{{ yellow }}",
    "syntaxString": "{{ green }}",
    "syntaxNumber": "{{ orange }}",
    "syntaxType": "{{ bright_blue }}",
    "syntaxOperator": "{{ magenta }}",
    "syntaxPunctuation": "#1c2d28"
  }
}